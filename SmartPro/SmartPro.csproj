<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>SmartPro</AssemblyName>
    <RootNamespace>SmartPro</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>3.3.0</Version>
    <!-- Excel-DNA build settings -->
    <ExcelAddInName>Smart Pro</ExcelAddInName>
    <ExcelAddInExplicitExports>true</ExcelAddInExplicitExports>
  </PropertyGroup>

  <ItemGroup>
    <!-- Use the same versions as your NLOOKUP project if you prefer fixed numbers -->
    <PackageReference Include="ExcelDna.AddIn" Version="1.*" />
    <PackageReference Include="ExcelDna.IntelliSense" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
