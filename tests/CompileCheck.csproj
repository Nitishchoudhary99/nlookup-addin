<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the add-in on any OS (also Linux CI) to catch build errors early.
       The real build for Excel stays SmartPro/SmartPro.csproj in Visual Studio on Windows. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>SmartPro</AssemblyName>
    <RootNamespace>SmartPro</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RunExcelDnaBuild>false</RunExcelDnaBuild>
    <RunExcelDnaPack>false</RunExcelDnaPack>
    <ExcelDnaCreate32BitAddIn>false</ExcelDnaCreate32BitAddIn>
    <ExcelDnaCreate64BitAddIn>false</ExcelDnaCreate64BitAddIn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SmartPro/*.cs" />
    <PackageReference Include="ExcelDna.AddIn" Version="1.8.0" />
    <PackageReference Include="ExcelDna.IntelliSense" Version="1.8.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
